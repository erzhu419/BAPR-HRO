  "clock_contracts": {
    "ideal": {
      "description": "Zero-latency controller under the same prepublished first-eligible-or-target platform command class."
    },
    "async": {
      "description": "Single-thread process-CPU replay. Each onboard query computes its base and optional continuation estimate serially; only the final completed proposal can be issued before actual train departure. When it misses the departure, the executor continues on the current vehicle; no alighting action is issued at the deadline. The completed action clock becomes the next platform entry. Platform commands are computed on entry, received RT messages and past departures. Each actual departure consumes only a previously published valid command, with no postdeparture grace; during platform computation the prior command remains active. Realized future departure clocks are executor-only.",
      "min_dwell_floor_seconds": 0.0,
      "terminal_dwell_window_seconds": 0.0,
      "platform_boarding_window_seconds": 0.0,
      "cpu_budget_scope": "SIGPROF interrupts the full query including preparation and inner evaluations. Full128 query cap120s; screen64 residual of1.8s including base, no query if exhausted. This is process-CPU interruption, not a hard wall-clock guarantee.",
      "nonpositive_dwell": "At a discretionary exit with nonpositive realized dwell, continue without a query. Terminal menu exits are mandatory alighting and use no artificial dwell interval.",
      "canceled_next_departure": "Cancellation supplies no door-closing endpoint. Preserve an unresolved outcome in archived execution and both forced rollout arms; do not treat cancellation as zero dwell or expose it as a controller observation."
    }
  },
  "mct_contracts": {
    "station_max": {
      "description": "Legacy single parent-station scalar min_transfer_time (e.g. 420s at Zurich HB)."
    },
    "platform_pair": {
      "description": "Static planned GTFS directed pair rule, otherwise assumed same-platform time, otherwise frozen station fallback. Real-time platform announcements are separate evidence and do not update the transfer-time contract.",
      "tau_same_platform_default_seconds": 90.0,
